POSTGRES_PASSWORD=змініть-на-довгий-випадковий-пароль
APP_PORT=3000
# demo — заповнити демо-даними з дизайну; prod — лише акаунт адміна mp@learntoearn.global
SEED_MODE=demo
# за reverse-proxy з HTTPS залиште true; для http://IP:порт у локальній мережі — false
COOKIE_SECURE=true

# --- AI-агент ---
# Ключі можна додати в інтерфейсі (Налаштування → AI-агент); тут — необовʼязково
ANTHROPIC_API_KEY=
# Розпізнавання голосу в Telegram (OpenAI); без нього бот працює лише з текстом
OPENAI_API_KEY=
# Ключ шифрування токена Telegram у БД: openssl rand -hex 32
APP_SECRET=
# Для посилань «Відкрити» у відповідях Telegram-бота
PUBLIC_URL=
