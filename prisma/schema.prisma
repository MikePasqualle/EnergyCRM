generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BLOCKED
}
enum ClientType {
  COMPANY
  FOP
  PERSON
}
enum ContactStatus {
  COLD
  WARM
  ACTIVE
}
enum StageType {
  WORKING
  WON
  LOST
}
enum Grp {
  A
  B
  UNSET
}
enum EntityStatus {
  ACTIVE
  ARCHIVED
}
enum PaymentStatus {
  PAID
  PENDING
}
enum ProductGroup {
  A
  B
  BOTH
}

model Role {
  id             Int     @id @default(autoincrement())
  name           String  @unique
  seeAllClients  Boolean @default(false)
  isAdmin        Boolean @default(false)
  isSystem       Boolean @default(false)
  // { section: { view, create, edit, delete } }
  permissions    Json
  users          User[]
}

model User {
  id                 Int        @id @default(autoincrement())
  name               String
  email              String     @unique
  passwordHash       String
  roleId             Int
  role               Role       @relation(fields: [roleId], references: [id])
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true)
  isOwner            Boolean    @default(false)
  failedAttempts     Int        @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  sessions           Session[]
  clients            Client[]
  deals              Deal[]
}

model Session {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String
  ok        Boolean
  at        DateTime @default(now())
  @@index([email, at])
}

model Supplier {
  id      Int          @id @default(autoincrement())
  name    String       @unique
  phone   String?
  status  EntityStatus @default(ACTIVE)
  shares  SupplierShare[]
}

model Product {
  id             Int          @id @default(autoincrement())
  name           String       @unique
  description    String       @default("")
  price          Decimal      @db.Decimal(12, 2) // ₴ / МВт·год
  tariffModel    String       @default("Фіксована")
  termMonths     Int          @default(12)
  minVolumeMwh   Int          @default(0)
  group          ProductGroup @default(BOTH)
  terms          String       @default("")
  status         EntityStatus @default(ACTIVE)
  deals          Deal[]
}

model Funnel {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String       @default("")
  status      EntityStatus @default(ACTIVE)
  position    Int          @default(0)
  stages      Stage[]
  deals       Deal[]
}

model Stage {
  id       Int       @id @default(autoincrement())
  funnelId Int
  funnel   Funnel    @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  name     String
  position Int
  type     StageType @default(WORKING)
  color    String    @default("#a9c7f5")
  deals    Deal[]
  @@index([funnelId, position])
}

model Client {
  id             Int           @id @default(autoincrement())
  type           ClientType
  name           String
  edrpou         String?
  contactPerson  String?
  phone          String
  phoneNorm      String
  email          String?
  emailNorm      String?
  city           String?
  address        String?
  source         String?
  status         ContactStatus @default(COLD)
  managerId      Int
  manager        User          @relation(fields: [managerId], references: [id])
  createdAt      DateTime      @default(now())
  lastContactAt  DateTime?
  anonymizedAt   DateTime?
  systems        System[]
  deals          Deal[]
  comms          Communication[]
  payments       Payment[]
  assignments    ClientAssignment[]
  @@index([managerId, status])
  @@index([phoneNorm])
  @@index([emailNorm])
  @@index([city])
}

model ClientAssignment {
  id         Int      @id @default(autoincrement())
  clientId   Int
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromUserId Int?
  toUserId   Int
  byUserId   Int
  at         DateTime @default(now())
}

model Communication {
  id       Int      @id @default(autoincrement())
  clientId Int
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dealId   Int?
  channel  String
  summary  String
  authorId Int
  authorName String
  at       DateTime @default(now())
  @@index([clientId, at])
}

model System {
  id                Int      @id @default(autoincrement())
  clientId          Int
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name              String
  objectType        String   @default("Виробничий")
  address           String?
  eic               String?
  powerKw           Int      @default(0)
  group             Grp      @default(UNSET)
  meterType         String   @default("Почасовий (інтервальний)")
  hasGeneration     Boolean  @default(false)
  genType           String?
  genPowerKw        Int?
  genMode           String?
  updatedAt         DateTime @default(now())
  updatedBy         String?
  shares            SupplierShare[]
  history           SystemHistory[]
  hourly            ConsumptionHourly[]
  monthly           ConsumptionMonthly[]
  @@index([clientId])
}

model SupplierShare {
  id         Int      @id @default(autoincrement())
  systemId   Int
  system     System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  validFrom  DateTime @db.Date
  validTo    DateTime? @db.Date
  sharePct   Int
}

model SystemHistory {
  id       Int      @id @default(autoincrement())
  systemId Int
  system   System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  at       DateTime @default(now())
  userName String
  summary  String
}

model ConsumptionHourly {
  systemId Int
  system   System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  ts       DateTime // початок години, UTC
  kwh      Decimal  @db.Decimal(12, 3) // з мережі
  genKwh   Decimal  @default(0) @db.Decimal(12, 3) // власна генерація
  @@id([systemId, ts])
}

model ConsumptionMonthly {
  systemId Int
  system   System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  month    DateTime @db.Date // перше число місяця
  kwh      Decimal  @db.Decimal(14, 3) // з мережі
  genKwh   Decimal  @default(0) @db.Decimal(14, 3) // власна генерація
  source   String   @default("manual") // manual | hourly
  @@id([systemId, month])
}

model Deal {
  id               Int      @id @default(autoincrement())
  number           Int      @unique @default(autoincrement())
  clientId         Int
  client           Client   @relation(fields: [clientId], references: [id])
  funnelId         Int
  funnel           Funnel   @relation(fields: [funnelId], references: [id])
  stageId          Int
  stage            Stage    @relation(fields: [stageId], references: [id])
  productId        Int
  product          Product  @relation(fields: [productId], references: [id])
  priceSnapshot    Decimal  @db.Decimal(12, 2)
  volumeMwh        Decimal  @db.Decimal(12, 2) // очікуваний річний обсяг
  amount           Decimal  @db.Decimal(14, 2) // сума за місяць
  ownerId          Int
  owner            User     @relation(fields: [ownerId], references: [id])
  note             String   @default("")
  lostReason       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())
  closedAt         DateTime?
  history          DealStageHistory[]
  payments         Payment[]
  @@index([funnelId, stageId])
  @@index([clientId])
  @@index([ownerId])
}

model DealStageHistory {
  id          Int      @id @default(autoincrement())
  dealId      Int
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage   String?
  toStage     String
  userName    String
  at          DateTime @default(now())
}

model Payment {
  id       Int           @id @default(autoincrement())
  dealId   Int
  deal     Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  clientId Int
  client   Client        @relation(fields: [clientId], references: [id])
  date     DateTime      @db.Date
  purpose  String
  amount   Decimal       @db.Decimal(14, 2)
  status   PaymentStatus @default(PENDING)
  @@index([date, status])
}

model Dictionary {
  id       Int    @id @default(autoincrement())
  kind     String // SOURCE | OBJECT_TYPE | CHANNEL | LOSS_REASON
  name     String
  position Int    @default(0)
  @@unique([kind, name])
}

model SavedFilter {
  id     Int    @id @default(autoincrement())
  userId Int
  name   String
  params Json
}

model Setting {
  key   String @id
  value String
}

model AuditLog {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now())
  userId   Int?
  userName String
  action   String
  entity   String
  label    String
  details  String   @default("")
  @@index([at])
}

/// Розмова з AI-агентом (веб-панель або Telegram)
model AgentThread {
  id        Int            @id @default(autoincrement())
  userId    Int
  channel   String         // web | telegram
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now())
  messages  AgentMessage[]
  actions   AgentAction[]
  @@index([userId, channel, updatedAt])
}

/// Повідомлення в форматі Claude API (content зберігається як є — для коректного повтору)
model AgentMessage {
  id       Int         @id @default(autoincrement())
  threadId Int
  thread   AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role     String      // user | assistant
  content  Json
  at       DateTime    @default(now())
  @@index([threadId, id])
}

/// Запропонована агентом зміна даних, що чекає на підтвердження користувача
model AgentAction {
  id        String      @id
  threadId  Int
  thread    AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    Int
  tool      String
  input     Json
  card      Json
  status    String      @default("PENDING") // PENDING | DONE | CANCELLED | FAILED
  createdAt DateTime    @default(now())
  @@index([threadId, status])
}
